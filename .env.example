# mise（mise.toml の [env]）が .env を読み込む。cp .env.example .env して値を埋める。.env は git に入れない

# CLI が使うリモート（R2）
CLOUDLAUNCH_S3_ENDPOINT=https://<アカウント ID>.r2.cloudflarestorage.com
CLOUDLAUNCH_S3_BUCKET=
CLOUDLAUNCH_S3_ACCESS_KEY_ID=
CLOUDLAUNCH_S3_SECRET_ACCESS_KEY=
# 省くと auto になる
# CLOUDLAUNCH_S3_REGION=

# objstore の契約テストの接続先（compose.yaml の versitygw）
CLOUDLAUNCH_TEST_S3_ENDPOINT=http://127.0.0.1:7070
CLOUDLAUNCH_TEST_S3_BUCKET=cloudlaunch-test
CLOUDLAUNCH_TEST_S3_ACCESS_KEY_ID=testuser
CLOUDLAUNCH_TEST_S3_SECRET_ACCESS_KEY=testsecret
